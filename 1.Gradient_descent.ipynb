import numpy as np  import matplotlib.pyplot as plt 
from numpy import arange 

# 目標函數：y = x^2
def func(x): 
    return np.square(x)  # 回傳 x 的平方

# 目標函數一階導數：dy/dx = 2*x (即梯度)
def dfunc(x): 
    return 2 * x  # 回傳 2 乘以 x

# 梯度下降法主程式
def GD(x_start, df, epochs, lr):
    xs = np.zeros(epochs+1) 
    x = x_start  # 將 x 設為起始點
    xs[0] = x  # 將起始點記錄到陣列的第一個位置
    for i in range(epochs):  # 開始進行指定次數的反覆運算
        dx = df(x)  # 計算當前位置的梯度 (斜率)
        v = - dx * lr  # 計算 x 應該移動的幅度和方向 (梯度的反方向乘以學習率)
        x += v  # 更新 x 的位置 (x = x + v)
        xs[i+1] = x  # 將更新後的 x 記錄到陣列中
    return xs  # 回傳陣列

# --- 執行與設定參數 ---
x_start = 5  # 設定 x 的起始權重為 5
epochs = 20  # 設定迭代的週期數為 20 次
lr = 0.3  # 設定學習率 (步長) 為 0.3

# 呼叫梯度下降函數並取得更新軌跡
x = GD(x_start, dfunc, epochs, lr=lr)
print(x)  # 在終端機印出 x 的歷史更新數值

# --- 繪製圖像 ---
color = 'r'  # 設定軌跡點與折線的顏色為紅色 (red)

# 產生繪製目標函數曲線所需的 x 軸數據，範圍從 -6.0 到 6.0，間隔 0.01
t = arange(-6.0, 6.0, 0.01)

plt.plot(t, func(t), c='b')  # 繪製藍色的目標函數 y = x^2 曲線
plt.plot(x, func(x), c=color, label='lr={}'.format(lr))  # 繪製紅色的梯度下降更新軌跡折線，並加上學習率標籤
plt.scatter(x, func(x), c=color)  # 在圖像上點出每次更新的實心紅色散點
plt.legend()  # 顯示圖例 (例如 lr=0.3)

plt.show()  # 顯示圖表
